// order-service database. Owned by order-service only (database-per-service).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @map("customer_id")
  // Money as integer minor units (cents) to avoid floating-point rounding.
  totalCents Int         @map("total_cents")
  currency   String      @db.Char(3)
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  items      OrderItem[]

  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  sku            String
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// Transactional outbox: written in the same transaction as the order, relayed to Kafka by
// OutboxRelay. id = the event's eventId, so consumers can deduplicate on it.
model OutboxEvent {
  id          String    @id @db.Uuid
  // Kafka message key (orderId): keeps one order's events in one partition, in order.
  aggregateId String    @map("aggregate_id") @db.Uuid
  // Versioned event type; also the Kafka topic name (e.g. order.created.v1).
  type        String
  // Full event envelope, sent as the message value unchanged.
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@map("outbox")
}

# Copy to .env for local development. Never commit .env.
# Local-only placeholder credentials; real secrets come from a secret store.
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orders
POSTGRES_PORT=5432

# order-service
NODE_ENV=development
ORDER_SERVICE_PORT=3001
ORDER_DATABASE_URL=postgresql://shopflow:change-me@localhost:5432/orders?schema=public

# Kafka (docker compose exposes the broker on localhost:9092, Kafka UI on :8080)
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service
KAFKA_GROUP_ID=order-service

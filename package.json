{
  "name": "shopflow",
  "version": "0.0.0",
  "private": true,
  "description": "ShopFlow: event-driven e-commerce backend built with NestJS microservices",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build order-service",
    "start:order": "nest start order-service --watch",
    "start:order:prod": "node dist/apps/order-service/apps/order-service/src/main.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest-e2e.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/terminus": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}

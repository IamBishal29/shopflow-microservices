{
  "name": "shopflow",
  "version": "0.0.0",
  "private": true,
  "description": "ShopFlow: event-driven e-commerce backend built with NestJS microservices",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build order-service && nest build payment-service",
    "start:order": "nest start order-service --watch",
    "start:order:prod": "node dist/apps/order-service/apps/order-service/src/main.js",
    "start:payment": "nest start payment-service --watch",
    "start:payment:prod": "node dist/apps/payment-service/apps/payment-service/src/main.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest-e2e.config.js",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "prisma generate --config apps/order-service/prisma.config.ts && prisma generate --config apps/payment-service/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config apps/order-service/prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config apps/order-service/prisma.config.ts",
    "prisma:migrate:payment": "prisma migrate dev --config apps/payment-service/prisma.config.ts",
    "prisma:deploy:payment": "prisma migrate deploy --config apps/payment-service/prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "kafkajs": "2.2.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
